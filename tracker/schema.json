{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zerostat-tracker tool entry",
  "description": "Schema for a single AI tool entry in the zerostat-tracker dataset. Public-facing fields are safe; 'notes' may contain private observations.",
  "type": "object",
  "required": [
    "tool_id",
    "name",
    "vendor",
    "category",
    "url",
    "one_line_pitch",
    "your_take",
    "rubric_scores",
    "pricing_model",
    "status",
    "last_checked",
    "first_added",
    "sources"
  ],
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,40}$",
      "description": "Stable slug. Never changes after creation. Used in URLs."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Company or individual that makes the tool."
    },
    "category": {
      "type": "string",
      "enum": ["smb-general", "home-ai"],
      "description": "Two categories at launch. Single-lane discipline."
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "docs_url": {
      "type": "string",
      "format": "uri"
    },
    "pricing_model": {
      "type": "string",
      "enum": ["free", "freemium", "paid", "usage", "quote", "trial"]
    },
    "pricing_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": {"type": "string"},
          "price": {"type": "string", "description": "Display string, e.g. '$20/mo' or 'Free'"},
          "period": {"type": "string", "enum": ["month", "year", "one-time", "usage"]},
          "notes": {"type": "string"}
        }
      }
    },
    "mcp_support": {
      "type": "string",
      "enum": ["yes", "no", "partial", "unknown"]
    },
    "api_available": {
      "type": "boolean"
    },
    "integrations": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 10,
      "description": "Top integrations, capped at 10 for readability."
    },
    "last_updated_vendor": {
      "type": "string",
      "format": "date",
      "description": "Date vendor last shipped a release, per their changelog."
    },
    "last_checked": {
      "type": "string",
      "format": "date",
      "description": "Date we verified all the above. The trust signal."
    },
    "first_added": {
      "type": "string",
      "format": "date",
      "description": "Date this entry was first added to the dataset."
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "acquired", "sunset", "unverified"],
      "description": "Sunset/deprecated entries stay in the dataset with history."
    },
    "one_line_pitch": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200,
      "description": "What is this, plain English, 1 sentence."
    },
    "your_take": {
      "type": "string",
      "minLength": 40,
      "maxLength": 600,
      "description": "Honest view in Will's voice. 2-3 sentences. No magic weights."
    },
    "rubric_scores": {
      "type": "object",
      "required": ["capability", "cost", "reliability", "ecosystem", "momentum"],
      "properties": {
        "capability": {"type": "integer", "minimum": 1, "maximum": 10},
        "cost": {"type": "integer", "minimum": 1, "maximum": 10},
        "reliability": {"type": "integer", "minimum": 1, "maximum": 10},
        "ecosystem": {"type": "integer", "minimum": 1, "maximum": 10},
        "momentum": {"type": "integer", "minimum": 1, "maximum": 10}
      },
      "description": "1-10 ratings with NO fixed weights. Used for sort/filter only. Reasons for each rating live in rubric_reasons."
    },
    "rubric_reasons": {
      "type": "object",
      "required": ["capability", "cost", "reliability", "ecosystem", "momentum"],
      "properties": {
        "capability": {"type": "string", "minLength": 10, "maxLength": 280},
        "cost": {"type": "string", "minLength": 10, "maxLength": 280},
        "reliability": {"type": "string", "minLength": 10, "maxLength": 280},
        "ecosystem": {"type": "string", "minLength": 10, "maxLength": 280},
        "momentum": {"type": "string", "minLength": 10, "maxLength": 280}
      },
      "description": "One sentence (10-280 chars) per axis explaining why it scored that number. Plain English, no AI tells."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "date"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "date": {"type": "string", "format": "date"},
          "note": {"type": "string"}
        }
      },
      "minItems": 1,
      "description": "Every claim must trace to at least one source. Content-farm differentiator."
    },
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Private observations. May contain 'known bugs', 'gotchas', 'regional limits'. Not public."
    }
  }
}